# Configuración del Emisor DTE (SII Chile)
SII_RUT_EMISOR=76123456
SII_DV_EMISOR=0
SII_RAZON_SOCIAL="Mi Empresa SpA"
SII_GIRO="Servicios Informáticos y Desarrollo de Software"
SII_DIRECCION="Av. Providencia 1234, Of. 501"
SII_CIUDAD="Santiago"
SII_CODIGO_ACTIVIDAD=620200

# Ambiente: 'certificacion' o 'produccion'
SII_AMBIENTE=certificacion

# Resolución SII (en ambiente certificacion usar 0 y 2019-10-18)
SII_NUMERO_RESOLUCION=0
SII_FECHA_RESOLUCION=2019-10-18

# Certificado Digital (.p12 / .pfx)
# Opción 1: Ruta en el sistema de archivos (fuera de directorios públicos)
SII_CERT_PATH=/var/secure/certs/empresa.p12
SII_CERT_PASS=MiContrasenaSegura

# Opción 2: Base64 del certificado (para Docker / CI/CD)
# SII_CERT_B64=MIIK...
